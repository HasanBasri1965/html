      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Durum kodu 200 OK dönmeli\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Sağlık kontrolü status: ok ve student no doğru dönmeli\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.status).to.eql(\"ok\");",
              "    pm.expect(jsonData.student).to.eql(\"2311012812\");",
              "    pm.expect(jsonData).to.have.property(\"time\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
